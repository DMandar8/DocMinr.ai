# ======================================================
# DocMinr.ai Environment Variables
# ======================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Replace all placeholder values with your own.
#
# 3. Never commit your actual .env file.
#
# ======================================================

# ============================================
# Environment Configuration
# ============================================
NODE_ENV=development
PORT=8000

# ============================================
# MySQL Configuration
# ============================================
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=docminr_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# ============================================
# Backend Database Connection
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=docminr_db

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_secure_jwt_secret
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=*

# ============================================
# File Upload Limits
# ============================================
MAX_FILE_SIZE=52428800
MAX_FILES_PER_UPLOAD=100
MAX_TOTAL_UPLOAD_SIZE=524288000
UPLOAD_BATCH_SIZE=20
MAX_ZIP_SIZE=524288000
STORAGE_PATH=/app/storage/knowledge-bases

# ============================================
# AI Service Configuration
# ============================================
AI_SERVICE_URL=http://ai-service:8001

AI_SERVICE_APP_NAME=DocMinr.ai AI Service
AI_SERVICE_APP_VERSION=v1
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
AI_SERVICE_ENVIRONMENT=development
AI_SERVICE_DEBUG=true

AI_SERVICE_BACKEND_API_URL=http://backend:8000
AI_SERVICE_BACKEND_API_TIMEOUT=30

# ============================================
# Embedding Configuration
# ============================================
AI_SERVICE_EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_SERVICE_EMBEDDING_DIMENSIONS=384
AI_SERVICE_EMBEDDING_BATCH_SIZE=32

# ============================================
# Chunking Configuration
# ============================================
AI_SERVICE_CHUNK_SIZE=500
AI_SERVICE_CHUNK_OVERLAP=50
AI_SERVICE_CHUNK_SEPARATORS=["\n\n","\n",". "," ",""]

# ============================================
# Qdrant Configuration
# ============================================
AI_SERVICE_QDRANT_HOST=qdrant
AI_SERVICE_QDRANT_PORT=6333
AI_SERVICE_QDRANT_COLLECTION=docminr_docs

# ============================================
# MongoDB Configuration
# ============================================
AI_SERVICE_MONGODB_URI=mongodb://mongodb:27017
AI_SERVICE_MONGODB_DATABASE=docminr

# ============================================
# Ollama Configuration
# ============================================
AI_SERVICE_OLLAMA_URL=http://ollama:11434
AI_SERVICE_OLLAMA_MODEL=llama2:7b
AI_SERVICE_LLM_TEMPERATURE=0.3
AI_SERVICE_LLM_MAX_TOKENS=2048

# ============================================
# Retrieval Configuration
# ============================================
AI_SERVICE_DEFAULT_TOP_K=5
AI_SERVICE_SIMILARITY_THRESHOLD=0.3

# ============================================
# Storage Configuration
# ============================================
AI_SERVICE_STORAGE_PATH=/app/storage
AI_SERVICE_TEMP_PATH=/app/temp

# ============================================
# Logging
# ============================================
AI_SERVICE_LOG_LEVEL=INFO

# ============================================
# Gemini API
# ============================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash